    "App Store Connect is preparing analytics reports for your apps. The first ones usually arrive within two days." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "App Store Connect erstellt gerade Analyseberichte für deine Apps. Die ersten treffen meist innerhalb von zwei Tagen ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "App Store Connect está preparando informes de análisis para tus apps. Los primeros suelen llegar en dos días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "App Store Connect prépare les rapports d'analyse de vos applications. Les premiers arrivent généralement dans les deux jours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "App Store Connectがアプリの分析レポートを準備しています。最初のレポートは通常2日以内に届きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "App Store Connect 正在为你的应用准备分析报告。首批报告通常会在两天内送达。"
