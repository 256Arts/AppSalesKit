    "An unknown error occurred. Please file a bug report." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein unbekannter Fehler ist aufgetreten. Bitte melde einen Fehler."
          }
        },
        "es" : {
